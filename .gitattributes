# Normalize text files to LF so Windows and Linux contributors don't fight over line endings.
* text=auto eol=lf

# Binary assets: never diff or merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.fbx binary
*.blend binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
